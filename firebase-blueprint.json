{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Pet": {
      "title": "Pet",
      "description": "Pet profile and analysis results",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["Cat", "Dog", "Bird", "Other"] },
        "breed": { "type": "string" },
        "ageEstimation": { "type": "string" },
        "energyLevel": { "type": "string" },
        "carePlan": { "type": "string" },
        "diyHacks": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "feedingRemindersEnabled": { "type": "boolean" },
        "feedingTimes": {
          "type": "object",
          "properties": {
            "breakfast": { "type": "string" },
            "lunch": { "type": "string" },
            "dinner": { "type": "string" }
          }
        }
      },
      "required": ["name", "imageUrl", "ownerId", "breed"]
    },
    "HealthLog": {
      "title": "Health Log",
      "description": "Log of pet health symptoms and AI analysis",
      "type": "object",
      "properties": {
        "petId": { "type": "string" },
        "symptoms": { "type": "string" },
        "imageUrl": { "type": "string" },
        "diagnosis": { "type": "string" },
        "description": { "type": "string" },
        "careInstructions": { "type": "string" },
        "vetUrgency": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["petId", "symptoms", "diagnosis"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/pets/{petId}": {
      "schema": "Pet",
      "description": "Pet profiles belonging to a user"
    },
    "/users/{userId}/pets/{petId}/healthLogs/{logId}": {
      "schema": "HealthLog",
      "description": "Health analysis logs for a pet"
    }
  }
}
