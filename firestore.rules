rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
      
      function isValidUser(data) {
        return data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 256
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024));
      }

      // --- Pet Profile Rules ---
      match /pets/{petId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPet(incoming());
        allow update: if isOwner(userId) && isValidPet(incoming())
                       && incoming().ownerId == existing().ownerId
                       && (
                         // Action: Update Details
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'breed', 'ageEstimation', 'energyLevel', 'carePlan', 'diyHacks', 'updatedAt', 'feedingRemindersEnabled', 'feedingTimes'])
                       );
        allow delete: if isOwner(userId);

        function isValidPet(data) {
          // Strict validation of the pet document structure
          return data.ownerId == request.auth.uid
            && data.name is string && data.name.size() > 0 && data.name.size() <= 128
            && data.imageUrl is string && data.imageUrl.size() <= 2000000 
            && data.category is string && data.category.size() <= 32
            && data.breed is string && data.breed.size() <= 256
            && (data.ageEstimation == null || (data.ageEstimation is string && data.ageEstimation.size() <= 128))
            && (data.energyLevel == null || (data.energyLevel is string && data.energyLevel.size() <= 128))
            && (data.carePlan == null || (data.carePlan is string && data.carePlan.size() <= 20000))
            && (data.diyHacks == null || (data.diyHacks is string && data.diyHacks.size() <= 20000))
            && (data.feedingRemindersEnabled == null || data.feedingRemindersEnabled is bool)
            && (data.feedingTimes == null || data.feedingTimes is map)
            && data.createdAt != null
            && data.updatedAt != null;
        }
      }
    }
  }
}
