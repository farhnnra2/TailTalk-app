rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/connection {
      allow get: if true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin', 'uid', 'email', 'createdAt'])
      );
      
      function isValidUser(data) {
        return data.uid == userId
          && (data.email == null || (data.email is string && data.email.size() <= 256))
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000000))
          && (data.lastLogin == null || data.lastLogin != null)
          && (data.createdAt == null || data.createdAt != null);
      }


      // --- Notification Rules ---
      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotification(incoming());
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          || isValidNotification(incoming())
        );
        allow delete: if isOwner(userId);

        function isValidNotification(data) {
          return data.text is string && data.text.size() <= 1000
            && (data.type == null || (data.type is string && data.type.size() <= 32))
            && (data.isRead == null || data.isRead is bool)
            && data.createdAt != null;
        }
      }

      // --- Pet Profile Rules ---
      match /pets/{petId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPet(incoming());
        allow update: if isOwner(userId)
                       && incoming().ownerId == userId
                       && (
                         // Action: Update Details
                         incoming().diff(existing()).affectedKeys().hasAll(['updatedAt'])
                         && incoming().diff(existing()).affectedKeys().hasAny(['name', 'category', 'breed', 'ageEstimation', 'energyLevel', 'carePlan', 'diyHacks', 'updatedAt', 'feedingRemindersEnabled', 'feedingTimes', 'foodRecommendations', 'nutritionTip'])
                         && (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'breed', 'ageEstimation', 'energyLevel', 'carePlan', 'diyHacks', 'updatedAt', 'feedingRemindersEnabled', 'feedingTimes', 'foodRecommendations', 'nutritionTip']))
                       )
                       && (
                         // Schema Check
                         (incoming().name == null || (incoming().name is string && incoming().name.size() <= 128))
                         && (incoming().updatedAt != null)
                       );
        allow delete: if isOwner(userId);

        function isValidPet(data) {
          // Strict validation of the pet document structure
          return data.ownerId == request.auth.uid
            && data.name is string && data.name.size() > 0 && data.name.size() <= 128
            && data.imageUrl is string && data.imageUrl.size() <= 2000000 
            && data.category is string && data.category.size() <= 32
            && data.breed is string && data.breed.size() <= 256
            && (data.ageEstimation == null || (data.ageEstimation is string && data.ageEstimation.size() <= 128))
            && (data.energyLevel == null || (data.energyLevel is string && data.energyLevel.size() <= 128))
            && (data.carePlan == null || (data.carePlan is string && data.carePlan.size() <= 20000))
            && (data.diyHacks == null || (data.diyHacks is string && data.diyHacks.size() <= 20000))
            && (data.foodRecommendations == null || (data.foodRecommendations is string && data.foodRecommendations.size() <= 20000))
            && (data.nutritionTip == null || (data.nutritionTip is string && data.nutritionTip.size() <= 5000))
            && (data.feedingRemindersEnabled == null || data.feedingRemindersEnabled is bool)
            && (data.feedingTimes == null || data.feedingTimes is map)
            && data.createdAt != null
            && data.updatedAt != null;
        }
      }
    }
  }
}
